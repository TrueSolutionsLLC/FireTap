// Secrets.xcconfig.example
// ---------------------------------------------------------------------------
// Copy this file to `Secrets.xcconfig` (same folder) and fill in the values
// from your Google Cloud OAuth client. `Secrets.xcconfig` is git-ignored and
// must NEVER be committed.
//
// How to obtain these values:
//   1. Google Cloud Console → APIs & Services → Credentials.
//   2. Create an OAuth 2.0 Client ID of type **iOS**.
//      (iOS clients are public clients and have NO client secret — this app
//       uses Authorization Code Flow with PKCE, so no secret is required.)
//   3. Set the bundle ID to match APP_BUNDLE_ID in Shared.xcconfig.
//   4. Copy the "Client ID" below.
//   5. The redirect scheme is the client ID reversed, i.e. the
//      "iOS URL scheme" Google shows you (com.googleusercontent.apps.XXXXX).
//
// See docs/OAUTH_SETUP.md for the full walkthrough and the Google
// verification checklist.
// ---------------------------------------------------------------------------

// Full client id, e.g. 1234567890-abcdef.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID = REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com

// Reversed client id / "iOS URL scheme", e.g. com.googleusercontent.apps.1234567890-abcdef
GOOGLE_OAUTH_REDIRECT_SCHEME = com.googleusercontent.apps.REPLACE_WITH_YOUR_CLIENT_ID
