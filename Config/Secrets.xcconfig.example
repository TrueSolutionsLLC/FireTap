// Secrets.xcconfig.example
// ---------------------------------------------------------------------------
// Copy this file to `Secrets.xcconfig` (same folder) and fill in the values
// from your Google Cloud OAuth *iOS* client. `Secrets.xcconfig` is git-ignored
// and must NEVER be committed.
//
// FireTap uses the official Google Sign-In SDK (Authorization Code + PKCE).
// iOS clients are public clients — there is NO client secret.
//
// Steps:
//   1. Google Cloud Console → APIs & Services → Credentials.
//   2. Create an OAuth 2.0 Client ID of type **iOS**.
//   3. Set Bundle ID to APP_BUNDLE_ID (com.truesolutions.firetap).
//   4. Paste Client ID below.
//   5. Paste the "iOS URL scheme" Google shows (reversed client id) below.
//      Example: com.googleusercontent.apps.1234567890-abcdef
//   6. Enable Firebase Management API for project listing.
//
// See docs/OAUTH_SETUP.md for the full walkthrough and verification checklist.
// ---------------------------------------------------------------------------

// Full client id, e.g. 1234567890-abcdef.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID = REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com

// MUST be Google's reversed client id / "iOS URL scheme" (not a custom scheme).
GOOGLE_OAUTH_REDIRECT_SCHEME = com.googleusercontent.apps.REPLACE_WITH_YOUR_CLIENT_ID
